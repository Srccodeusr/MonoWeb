# PLATFORM ENVIRONMENT CONFIGURATION EXAMPLE
# Copy or set these environment variables in your server / container deployment environment.

# JWT Secret used for signing admin and user authentication tokens.
# Leave EMPTY to auto-generate a strong one (stored in data/.jwt_secret, mode 600).
# Placeholder / short values are rejected on purpose. Generate one with:  openssl rand -base64 48
JWT_SECRET=""

# Key that encrypts secrets stored in data/db.json (node daemon keys, Stripe keys).
# Leave EMPTY to auto-generate (data/.app_secret). BACK THIS UP: losing it means re-entering node/Stripe secrets.
APP_SECRET=""

# Initial Super Admin credentials for bootstrap initialization (first start only).
# Set your own email. Leave the password EMPTY to have a strong random one generated and printed once in the server log.
# Never reuse an example password: it is public. (The old sample password "MonoPanelOPP" is rejected on purpose.)
AETHER_ADMIN_EMAIL="admin@monopanel.com"
AETHER_ADMIN_PASSWORD="MonoPanelOPP"

# Installation Isolation & Identity Keys
AETHER_INSTALLATION_ID="inst_default_01"
# Leave EMPTY to auto-generate. Do not keep the sample value on a real deployment.
AETHER_INSTALLATION_SECRET=""

# Public site URL. REQUIRED in production: used for Stripe redirects, the webhook URL shown in Admin and OAuth callbacks.
APP_URL="http://localhost:3000"

# Reverse proxy hops to trust for client IPs (rate limits, bans). Default: 1 in production, 0 in development.
# Set to the number of proxies in front of the app (e.g. 1 for Nginx/Caddy, 2 for Cloudflare + Nginx), or "false".
TRUST_PROXY=""
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Anti-abuse / IP risk provider (Optional)
VPN_CHECK_API_KEY=""

# Discord OAuth2 App Credentials & Bot Integration (Optional)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/api/v1/auth/discord/callback"
DISCORD_BOT_TOKEN=""

# Firebase Web App Credentials for Google Sign-In (Optional)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Node environment mode
NODE_ENV="production"

# SQLite database file (default: data/mono.sqlite). Needs Node.js 22.13+.
# An old data/db.json is imported automatically on first start.
DATABASE_FILE=""

# MySQL / MariaDB host used by the "Databases" tab of each server (Optional).
# The admin account must be allowed to CREATE DATABASE, CREATE USER and GRANT. Leave DB_HOST_ADDRESS empty to hide database creation.
DB_HOST_ADDRESS=""
DB_HOST_PORT="3306"
DB_HOST_ADMIN_USER=""
DB_HOST_ADMIN_PASSWORD=""
# Address customers should connect to (defaults to DB_HOST_ADDRESS / DB_HOST_PORT)
DB_HOST_PUBLIC_ADDRESS=""
DB_HOST_PUBLIC_PORT=""

# ==============================================================
# PTERODACTYL / LAUNCHER (main.js)  -  startup command: node main.js
# ==============================================================
# The port comes from the panel allocation (SERVER_PORT) automatically; PORT is only the fallback.
# PORT="3000"

# Console status panel interval in seconds (0 = only when you type "status").
STATUS_INTERVAL="600"
# Set true for one start to force npm install + rebuild (needed after changing VITE_* values).
FORCE_BUILD="false"

# ---- Cloudflare Tunnel (pick ONE mode, or leave everything empty to skip) ----
# off | quick | token | auto   (empty = detect from the variables below)
CF_TUNNEL_MODE=""

# token : run a tunnel you created in Zero Trust -> Networks -> Tunnels.
#         Set its public hostname's service to http://localhost:<your allocation port>.
CF_TUNNEL_TOKEN=""

# quick : temporary https://xxxx.trycloudflare.com URL, no Cloudflare account needed.
CF_QUICK_TUNNEL="false"

# auto  : creates the tunnel + ingress + DNS CNAME for you and keeps the port in sync.
#         API token needs: Account > Cloudflare Tunnel: Edit, Zone > DNS: Edit, Zone > Zone: Read.
CF_API_TOKEN=""
CF_ACCOUNT_ID=""
CF_ZONE_ID=""
CF_TUNNEL_NAME="monoweb"

# Public hostname (used by auto mode, and by token mode to set APP_URL automatically).
CF_HOSTNAME=""

# Optional: force http2 if the host blocks UDP/QUIC (empty = cloudflared default).
CF_PROTOCOL=""
