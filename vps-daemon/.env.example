# MonoVPS daemon configuration. Easiest: Admin > VPS > Nodes > Add node, then run the command it shows:
#   npm run configure -- --panel https://your-panel --key <SECRET>
DAEMON_SECRET=
DAEMON_HOST=0.0.0.0
DAEMON_PORT=3100
# Comma-separated panel IPs allowed to call this daemon (strongly recommended)
ALLOWED_IPS=
# Optional TLS
TLS_CERT=
TLS_KEY=
# docker | mock   (mock = fake in-memory VPSes for development without Docker; never use in production)
RUNTIME=docker
# Optional OCI runtime for stronger isolation (e.g. sysbox-runc, runsc)
OCI_RUNTIME=
# Base images the panel may ask for (comma-separated prefixes). Debian/Ubuntu family only (apt is used to install sshd).
ALLOWED_BASE_PREFIXES=ubuntu:,debian:
DATA_DIR=./data
# --- MonoPanel ROM (Docker, Node.js, pm2 and ptreodoctyl-install are pre-installed in every VPS) ---
# Docker inside a VPS needs ONE of: OCI_RUNTIME=sysbox-runc (recommended, secure) or VPS_PRIVILEGED=true (insecure: VPS root can escape to the host).
VPS_PRIVILEGED=false
# OS ids to build the ROM image for at daemon start, so the first customer does not wait several minutes (comma-separated, e.g. ubuntu-22.04,debian-12)
PREBUILD_OS=ubuntu-22.04
