# MonoNode daemon configuration.
# Easiest way to fill this in: from the panel, Admin > Nodes > Add node, then run
# the one-line command it shows:  npm run configure -- --panel https://your-panel --key <SECRET>

# Shared secret generated by the panel when you add the node (>= 32 chars). REQUIRED.
DAEMON_SECRET=

# Network
DAEMON_HOST=0.0.0.0
DAEMON_PORT=3002
# Comma-separated panel IPs allowed to talk to the daemon. Strongly recommended.
ALLOWED_IPS=
# Optional TLS (recommended when the panel and node are on different networks)
TLS_CERT=
TLS_KEY=

# Runtime: auto | docker | podman | process
#   auto    -> docker socket if reachable, else podman socket, else native process sandbox
#   process -> no container engine needed (works on OpenVZ/LXC/Termux/tiny VPS)
RUNTIME=auto
# Docker/Podman API socket (Podman: /run/podman/podman.sock or $XDG_RUNTIME_DIR/podman/podman.sock)
CONTAINER_SOCKET=/var/run/docker.sock
# Optional OCI runtime for stronger sandboxing: runsc (gVisor), kata, sysbox-runc ...
OCI_RUNTIME=
# Process runtime sandbox: auto | bwrap | none
PROCESS_SANDBOX=auto

# Storage
DATA_DIR=./data
VOLUMES_DIR=./data/volumes
BACKUPS_DIR=./data/backups

# Host port range servers may bind (the panel allocates inside this range)
PORT_MIN=20000
PORT_MAX=40000

# Container user (files in volumes are chowned to this when the daemon runs as root)
CONTAINER_UID=1000
CONTAINER_GID=1000

# Only pull images whose name starts with one of these (comma-separated). Empty = any.
ALLOWED_IMAGE_PREFIXES=
# Allow installer file downloads from private networks (default false: blocks SSRF)
ALLOW_PRIVATE_DOWNLOADS=false
